# ==============================================================================
# ActionPulse Backend Environment Variables (Python 3.11+ / FastAPI)
# ==============================================================================
# Instructions:
# 1. Copy this file to `backend/.env`.
# 2. Fill in your Supabase Service-Role key, Bedrock API key, and SMTP credentials.
#
# ⚠️ SECURITY NOTICE:
# This file contains high-privilege keys (SERVICE_ROLE_KEY bypasses all RLS!).
# NEVER commit `backend/.env` to Git or expose these values to the browser!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Privileged Connection
# ------------------------------------------------------------------------------
# Project URL (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service-Role Secret Key (from Supabase Dashboard -> Settings -> API)
# Used by FastAPI to create tasks, update extracted_items, and bypass RLS safely.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Amazon Bedrock (server-side only; AWS credits are account-specific)
# ------------------------------------------------------------------------------
# Generate in the Amazon Bedrock console -> API keys. Never use a VITE_ prefix.
AWS_BEARER_TOKEN_BEDROCK=
# Use the region for which your key was generated and a model available there.
AWS_REGION=us-east-1
# Must support Converse and tool calling for structured extraction/chat/summaries.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Allow-list of permitted LLM providers (comma-separated)
LLM_PROVIDER_ALLOWLIST=bedrock,gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 3. Email Delivery (Free SMTP: Gmail App Password or Brevo Free Tier)
# ------------------------------------------------------------------------------
# Standard SMTP Host (e.g. smtp.gmail.com or smtp-relay.brevo.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail: Use a 16-character Google App Password (not your normal password!)
SMTP_PASS=your-16-char-app-password
MAIL_FROM=ActionPulse <your-email@gmail.com>
# Brevo API key (Brevo > SMTP & API > API Keys, starts with xkeysib-). Required on
# Render free tier, which blocks SMTP ports; when set, SMTP_* above is ignored.
# MAIL_FROM's address must be a verified sender in Brevo.
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 4. Web Push Notification Keys (VAPID) - Optional for Sprint 1
# ------------------------------------------------------------------------------
# Generated via: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@actionpulse.app

# ------------------------------------------------------------------------------
# 5. Google Calendar Integration (OAuth 2.0 - Free Tier)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Frontend callback or backend redirect URI
GOOGLE_REDIRECT_URI=http://localhost:5173/calendar/callback
CALENDAR_ENCRYPTION_SECRET=your-random-32-char-encryption-key

# ------------------------------------------------------------------------------
# 6. Application & Server Settings
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (Vite default is 5173, Next default is 3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Secret token required to trigger the /internal/tick scheduler endpoint
INTERNAL_TICK_SECRET=your-random-32-char-secret-key-here
