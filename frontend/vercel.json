{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-meeting-action-converter.onrender.com/api/:path*"
    },
    {
      "source": "/internal/:path*",
      "destination": "https://ai-meeting-action-converter.onrender.com/internal/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://ai-meeting-action-converter.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://ai-meeting-action-converter.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://ai-meeting-action-converter.onrender.com/openapi.json"
    },
    {
      "source": "/health",
      "destination": "https://ai-meeting-action-converter.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
