{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/github/callback",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-powered-meeting-to-action-converter-9k2z.onrender.com/api/:path*"
    },
    {
      "source": "/internal/:path*",
      "destination": "https://ai-powered-meeting-to-action-converter-9k2z.onrender.com/internal/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://ai-powered-meeting-to-action-converter-9k2z.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://ai-powered-meeting-to-action-converter-9k2z.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://ai-powered-meeting-to-action-converter-9k2z.onrender.com/openapi.json"
    },
    {
      "source": "/health",
      "destination": "https://ai-powered-meeting-to-action-converter-9k2z.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
