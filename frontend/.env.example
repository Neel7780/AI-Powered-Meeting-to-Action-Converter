# ==============================================================================
# ActionPulse Frontend Environment Variables (React + Vite)
# ==============================================================================
# Instructions:
# 1. Copy this file to `frontend/.env` (or `frontend/.env.local`).
# 2. Fill in your Supabase project credentials and FastAPI backend URL.
# 3. Access in React via: `import.meta.env.VITE_VARIABLE_NAME`
#
# ⚠️ SECURITY WARNING:
# Everything in this file is bundled into client-side JavaScript.
# NEVER put `SUPABASE_SERVICE_ROLE_KEY`, `GEMINI_API_KEY`, or SMTP secrets here!
# ==============================================================================

# Supabase Project Credentials (from Supabase Dashboard -> Settings -> API)
# 1. Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Project Anon/Public Key (Safe to expose to browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# FastAPI Backend URL
# - Local development: http://localhost:8000
# - Production on Render: https://actionpulse-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Web Push Notification Public Key (VAPID Public Key) - Optional for Sprint 1
# Generated via: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
